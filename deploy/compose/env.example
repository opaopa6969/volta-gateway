# Copy to deploy/compose/.env (git-ignored) and adjust. Every value is optional.

# Host port / bind address of the gateway.
VOLTA_PORT=18080
VOLTA_BIND=127.0.0.1
# Public origin and host as the browser sees them. Keep in sync with VOLTA_PORT.
VOLTA_PUBLIC_URL=http://localhost:18080
VOLTA_PUBLIC_HOST=localhost

# Secrets (dev defaults are used when unset — change them for anything shared).
POSTGRES_PASSWORD=
JWT_SECRET=

# Cookie / redirect scope (see docs/standalone-deploy.md).
COOKIE_DOMAIN=
ALLOWED_RETURN_TO_DOMAINS=

# System administrators for cross-tenant admin APIs (comma separated emails).
# Empty = nobody (tenant-scoped admin still works).
SYSTEM_ADMIN_EMAILS=

# Dev-only magic-link login. Set to false outside local development.
AUTH_EXPOSE_DEV_TOKEN=true

# Generic OIDC IdP (optional).
IDP_PROVIDER=
IDP_ISSUER_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_DISPLAY_NAME=
